{
  "turn_message": "do you like my art?",
  "turn_style": "serif",
  "idle": [
      "still there?",
      "asdf",
      "zork!",
      "hmm hmmm hmm hmm hmmmm"
  ],
  "nav_slots": [
    { "path": "/terminal", "label": "terminal" },
    { "path": "/essays", "label": "essays" },
    { "path": "/cave", "label": "cave" },
    { "path": "/privacy", "label": "privacy" },
    { "path": "/faq", "label": "faq" }
  ],
  "paths": [
    {
      "name": "yes",
      "after_turn_question": true,
      "start": "\\b(yes|yeah|yep|yup|yea|ya|sure|of course|i do|love it|like it)\\b|\\bit'?s (good|great|cool|pretty|beautiful)",
      "steps": [
        { "say": "I made it." },
        { "say": "I'm Charlize Theron!" },
        { "frames": [":)", ":D", ":DD", ":DDDD", ":DDDDDDDD"], "art": ":D" },
        { "say": "OK I'm not Charlize Theron." },
        { "say": "I'M BARACK OBAMA!!!!" },
        { "say": "for verification please send one (1) art." },
        { "art": true, "say": "i like your art." },
        { "say": "want to play a game?" },
        {
          "if": "\\b(yes|yeah|yep|yup|yea|ya|sure|ok|okay|y)\\b",
          "then": { "go": "/cave" },
          "else": { "say": "...okay." }
        }
      ]
    }
  ],
  "rules": [
    {
      "match": "\\bterminal|\\bcommand|\\bcmd\\b|\\bcli\\b|\\bshell",
      "action": "/terminal"
    },
    {
      "match": "\\bblog|\\bessay|\\bwrit|\\bread(?!y)",
      "action": "/essays"
    },
    {
      "match": "\\bcave|\\bsecret|\\bhidden|\\bexplor",
      "action": "/cave"
    },
    {
      "match": "\\b(\\w+)ice",
      "say": "$1 .. ice",
      "action": "/privacy"
    },
    {
      "match": "\\bpriva|\\bice\\b|\\bcops?\\b|\\bharvest|\\bcookie",
      "action": "/privacy"
    },
    {
      "match": "\\breset\\b|\\brestart\\b|xyzzy",
      "reply": ["*poof*"],
      "reset": true
    },
    {
      "match": "infrequently|unfrequently|\\biaq\\b",
      "action": "https://cs.stanford.edu/~knuth/iaq.html"
    },
    {
      "match": "\\bfrequently|\\bfaq|\\bquestion",
      "action": "/faq"
    },
    {
      "match": "zork",
      "action": "https://en.wikipedia.org/wiki/Zork"
    },
    {
      "match": "\\bnicole|\\bauthor|\\bmade\\b|\\bbuilt\\b|\\bcreated\\b",
      "reply": ["A console cowgirl, of course."]
    },
    {
      "match": "eliza|\\bname\\b|\\bcalled\\b|\\bwho\\b|\\byou$|\\byourself",
      "action": "https://en.wikipedia.org/wiki/ELIZA"
    },
    {
      "match": "\\bmyst|\\bmist\\b|\\bcyan\\b",
      "action": "https://medium.com/@andrewblackledge/all-the-ways-to-experience-myst-as-of-2021-16cc7b524e09"
    },
    {
      "match": "\\bturing|\\breal\\b|\\balive\\b|\\bhuman|\\bai\\b|\\brobot|\\bmachine|\\bchatbot|\\bllm",
      "action": "https://en.wikipedia.org/wiki/Finite-state_machine"
    },
    {
      "match": "\\bhelp|\\bstuck\\b|\\bwhat|\\bhow\\b|\\bwhere|\\?$",
      "reply": ["Try: blog, zork, or just talk."]
    },
    {
      "match": "\\bmake|\\bbuild",
      "action": "https://learn.microsoft.com/en-us/aspnet/core/tutorials/first-mvc-app/start-mvc"
    },
    {
      "match": "\\blove|\\bheart|\\bfeel",
      "action": "https://en.wikipedia.org/wiki/Amateur"
    },
    {
      "match": "\\bno[.!]*$|\\bnope|\\bhate|\\bugly|\\bbad\\b|\\bsuck",
      "reply": ["harsh, rhymes with marsh.", "ow, my I/O bus.", "...okay."]
    },
    {
      "match": "\\bhi\\b|\\bhello|\\bhey\\b|\\bgreet",
      "reply": ["hello.", "hi."]
    },
    {
      "match": "\\bwhy\\b",
      "reply": ["why not?"]
    },
    {
      "match": "crawford",
      "reply": ["good taste."]
    },
    {
      "match": "\\bthird|\\b3rd\\b",
      "action": "https://www.barnesandnoble.com/w/enders-game-orson-scott-card/1100353963"
    },
    {
      "fallback": true,
      "reply": ["please go on.", "that's very interesting.", "i see.", "earlier you said $input"]
    }
  ]
}
